{
  "semi": true,
  "singleQuote": true,
  "printWidth": 100,
  "trailingComma": "all",
  "plugins": ["prettier-plugin-tailwindcss"],
  "overrides": [
    {
      "files": "customer/**",
      "options": {
        "tailwindStylesheet": "./customer/src/app/globals.css"
      }
    },
    {
      "files": "admin/**",
      "options": {
        "tailwindStylesheet": "./admin/src/app/globals.css"
      }
    },
    {
      "files": "shared/**",
      "options": {
        "tailwindStylesheet": "./customer/src/app/globals.css"
      }
    }
  ]
}
