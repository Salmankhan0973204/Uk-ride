# Copy this file to .env and adjust. Never commit .env.
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
# PostgreSQL from docker-compose.yml: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://ukride:ukride@localhost:5432/ukride
# Signs login tokens. Replace with your own long random value (32 characters or more):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string-of-32-chars-or-more
# Lifetime of an access token in seconds (900 = 15 minutes).
JWT_ACCESS_TTL_SECONDS=900
