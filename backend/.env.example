# Copy this file to .env and adjust. Never commit .env.
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# PostgreSQL from docker-compose.yml: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://ukride:ukride@localhost:5432/ukride
# Redis from docker-compose.yml: shared counters such as codes sent per phone.
REDIS_URL=redis://localhost:6379
# Signs login tokens. Replace with your own long random value (32 characters or more):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string-of-32-chars-or-more
# Lifetime of an access token in seconds (900 = 15 minutes).
JWT_ACCESS_TTL_SECONDS=900
# Days a refresh token lasts: how long someone stays signed in.
REMEMBER_ME_DAYS=30
CUSTOMER_SESSION_HOURS=24
# Email. These defaults are Mailpit from docker-compose.yml, which catches every
# message and delivers none. Read them at http://localhost:8025.
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=UkRide <no-reply@ukride.local>
# Addresses of the customer site and the admin panel, used for links in emails.
CUSTOMER_APP_URL=http://localhost:3000
ADMIN_APP_URL=http://localhost:3001
# Real road distance for quotes. postcodes.io finds UK postcodes (free, no key).
# The routing default is the public OSRM demo server: free, but with no promise
# of staying up. Point it at another OSRM host before going live.
POSTCODES_API_URL=https://api.postcodes.io
ROUTING_API_URL=https://router.project-osrm.org
