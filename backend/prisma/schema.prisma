// The database shape lives in this file.
// After a change: npm run db:migrate -w backend -- --name what-changed

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  // Stored in international form, for example +447400123456.
  mobile       String   @unique
  // Optional: a booking does not need it, so the customer may leave it out.
  gender       Gender?
  // Only the hash is stored, never the password itself.
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}
