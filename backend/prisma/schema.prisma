// The database shape lives in this file.
// After a change: npm run db:migrate -w backend -- --name what-changed

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

// What a person may do. Everyone who registers is a customer; the other roles
// are given by the operator.
enum Role {
  CUSTOMER
  DRIVER
  DISPATCHER
  ADMIN
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  // Stored in international form, for example +447400123456.
  mobile       String   @unique
  // Optional: a booking does not need it, so the customer may leave it out.
  gender       Gender?
  role         Role     @default(CUSTOMER)
  // Only the hash is stored, never the password itself.
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Set when the person opens the link we emailed. Null until then.
  emailVerifiedAt DateTime? @map("email_verified_at")

  refreshTokens RefreshToken[]
  emailTokens   EmailToken[]

  @@map("users")
}

// One row per issued refresh token. A signed-in browser holds the token in a
// cookie; this table holds only its hash, so a copy of the database cannot be
// used to take over sessions.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  // Deleting a user removes their sessions with them.
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // One sign-in on one device. Rotation replaces the token but keeps this id,
  // and the access token carries it, so ending the session cuts off both.
  sessionId String    @map("session_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  // Set when the token is used (rotation) or the user signs out. A revoked
  // token that shows up again means it was copied.
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([sessionId])
  @@map("refresh_tokens")
}

enum EmailTokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

// A single-use link we email to someone: to confirm their address, or to let
// them choose a new password. As with refresh tokens, only a hash is stored.
model EmailToken {
  id        String            @id @default(uuid())
  userId    String            @map("user_id")
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   EmailTokenPurpose
  tokenHash String            @unique @map("token_hash")
  expiresAt DateTime          @map("expires_at")
  // Set when the link is used. A link works once.
  usedAt    DateTime?         @map("used_at")
  createdAt DateTime          @default(now()) @map("created_at")

  @@index([userId])
  @@map("email_tokens")
}

// A class of car a customer can book, for example Saloon or Executive.
// It describes the class, not one car: the cars themselves come in Module 4.
model VehicleType {
  id          String   @id @default(uuid())
  // Short, stable name for addresses and code, for example "executive".
  slug        String   @unique
  name        String
  description String
  // How many passengers and suitcases fit. Bookings will check against these.
  passengers  Int
  suitcases   Int
  // Lower numbers are listed first.
  sortOrder   Int      @default(0) @map("sort_order")
  // Switched off instead of deleted, so old bookings keep their vehicle type.
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("vehicle_types")
}
