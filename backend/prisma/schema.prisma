// The database shape lives in this file.
// After a change: npm run db:migrate -w backend -- --name what-changed

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

// What a person may do. Everyone who registers is a customer; the other roles
// are given by the operator.
enum Role {
  CUSTOMER
  DRIVER
  DISPATCHER
  ADMIN
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  // Stored in international form, for example +447400123456.
  mobile       String   @unique
  // Optional: a booking does not need it, so the customer may leave it out.
  gender       Gender?
  role         Role     @default(CUSTOMER)
  // Only the hash is stored, never the password itself.
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Set when the person proves they hold the mobile with a code. Null until then.
  phoneVerifiedAt DateTime? @map("phone_verified_at")
  // Set when the person proves they read the mailbox, with a code sent to it.
  // Null until then.
  emailVerifiedAt DateTime? @map("email_verified_at")

  refreshTokens RefreshToken[]
  // The journeys this person booked, and what they did to bookings.
  bookings      Booking[]
  bookingEvents BookingEvent[]

  @@map("users")
}

// Who a session is for. Customers sign in on the customer site; staff sign in
// on the admin panel, with their own cookie and shorter sessions. A token of
// one kind is never accepted by the other.
enum SessionAudience {
  CUSTOMER
  STAFF
}

// One row per issued refresh token. A signed-in browser holds the token in a
// cookie; this table holds only its hash, so a copy of the database cannot be
// used to take over sessions.
model RefreshToken {
  id            String          @id @default(uuid())
  userId        String          @map("user_id")
  // Deleting a user removes their sessions with them.
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  // One sign-in on one device. Rotation replaces the token but keeps this id,
  // and the access token carries it, so ending the session cuts off both.
  sessionId     String          @map("session_id")
  audience      SessionAudience @default(CUSTOMER)
  // How long this session lasts from its last refresh, chosen at sign-in:
  // 30 days with "Remember me", 1 day without, 12 hours for staff.
  lifetimeHours Int             @default(168) @map("lifetime_hours")
  tokenHash     String          @unique @map("token_hash")
  expiresAt     DateTime        @map("expires_at")
  // Set when the token is used (rotation) or the user signs out. A revoked
  // token that shows up again means it was copied.
  revokedAt     DateTime?       @map("revoked_at")
  createdAt     DateTime        @default(now()) @map("created_at")

  @@index([userId])
  @@index([sessionId])
  @@map("refresh_tokens")
}

// A class of car a customer can book, for example Saloon or Executive.
// It describes the class, not one car: the cars themselves come in Module 4.
model VehicleType {
  id            String   @id @default(uuid())
  // Short, stable name for addresses and code, for example "executive".
  slug          String   @unique
  name          String
  description   String
  // Shown as "Cars like ... or similar": "BMW 5 Series, Mercedes E Class".
  // The customer books the class, never one particular model.
  exampleModels String   @default("") @map("example_models")
  // How many passengers, suitcases and hand bags fit. Bookings will check against these.
  passengers    Int
  suitcases     Int
  handLuggage   Int      @default(0) @map("hand_luggage")
  // A picture of the class, as a web address. Uploads are not planned, so an
  // admin pastes the address of an image hosted elsewhere. None: no picture.
  imageUrl      String?  @map("image_url")
  // Lower numbers are listed first.
  sortOrder     Int      @default(0) @map("sort_order")
  // Switched off instead of deleted, so old bookings keep their vehicle type.
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // The cars of this class. One type has many vehicles; a vehicle has one type.
  vehicles    Vehicle[]
  // How this class is priced. At most one rule; none until an admin sets prices.
  pricingRule PricingRule?
  // The journeys booked in this class.
  bookings    Booking[]

  @@map("vehicle_types")
}

// Where a car is in its working life.
enum VehicleStatus {
  // Can be given jobs.
  ACTIVE
  // In the garage for now. Comes back to ACTIVE.
  MAINTENANCE
  // Left the fleet. Kept, because past bookings will name it.
  RETIRED
}

// One real car in the operator's fleet.
model Vehicle {
  id            String        @id @default(uuid())
  // The number plate without spaces, in capitals: "AB12CDE". Two cars
  // cannot share a plate, so the database refuses a second one.
  registration  String        @unique
  make          String
  model         String
  colour        String
  year          Int
  status        VehicleStatus @default(ACTIVE)
  vehicleTypeId String        @map("vehicle_type_id")
  // Restrict: a vehicle type that still has cars cannot be deleted. Types are
  // only switched off anyway, so this is a second line of defence.
  vehicleType   VehicleType   @relation(fields: [vehicleTypeId], references: [id], onDelete: Restrict)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  // The admin list filters by these two, so they get indexes.
  @@index([vehicleTypeId])
  @@index([status])
  @@map("vehicles")
}

// How a journey in one vehicle type is priced.
//
// Every amount is a whole number of pence: £12.50 is stored as 1250. Pounds
// with decimals would be stored as floating point, and 0.1 + 0.2 is not 0.3
// in floating point. Whole pence add up exactly.
model PricingRule {
  id                    String      @id @default(uuid())
  // @unique makes the relation one-to-one: a vehicle type has at most one rule.
  vehicleTypeId         String      @unique @map("vehicle_type_id")
  // Cascade: the rule belongs to its type and means nothing without it.
  vehicleType           VehicleType @relation(fields: [vehicleTypeId], references: [id], onDelete: Cascade)
  // Charged on every journey, before the first mile.
  baseFarePence         Int         @map("base_fare_pence")
  // Charged for each mile driven.
  perMilePence          Int         @map("per_mile_pence")
  // The least a journey costs, however short.
  minimumFarePence      Int         @map("minimum_fare_pence")
  // Added to the fare for a pick-up between 10pm and 6am, UK time. 25 means 25%.
  nightSurchargePercent Int         @default(0) @map("night_surcharge_percent")
  // A flat amount for a journey to or from an airport, added after any night surcharge.
  airportFeePence       Int         @default(0) @map("airport_fee_pence")
  // Taken off the whole fare, as on ukride.uk, where each class shows its
  // original price struck through. 10 means 10% off. 0 means no discount.
  discountPercent       Int         @default(0) @map("discount_percent")
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")

  @@map("pricing_rules")
}

// An airport we serve. A journey that starts, stops or ends at one pays the
// class's airport fee; a pick-up from one needs a flight number and may have
// Meet & Greet.
model Airport {
  id        String   @id @default(uuid())
  // The three-letter IATA code: "LHR". Shown beside the name, and searched.
  code      String   @unique
  name      String
  // Where the airport is when a customer picks it from the address search:
  // the main terminal's postcode, and that postcode's map position, looked
  // up when an admin saves it.
  postcode  String
  latitude  Float
  longitude Float
  // The postcodes that count as this airport, besides the main one. An entry
  // is a whole postcode ("RH6 0PJ"), a district ("TW6": every postcode in
  // it) or a sector ("RH6 0"). Most airports share their district with homes
  // nearby, so whole postcodes are the safe choice.
  postcodes String[]
  // Lower numbers are listed first.
  sortOrder Int      @default(0) @map("sort_order")
  // Switched off instead of deleted: old bookings keep their airport.
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("airports")
}

// The operator's booking rules, kept as data so an admin can change them
// without a new release. There is only ever one row, id 1; it is created with
// these defaults the first time it is read.
model Settings {
  id                   Int      @id @default(1)
  // The price of Meet & Greet on an airport pick-up: a driver waiting in
  // arrivals with a name board. Whole pence.
  meetGreetPence       Int      @default(1000) @map("meet_greet_pence")
  // How far ahead a pick-up must be booked.
  bookingLeadMinutes   Int      @default(240) @map("booking_lead_minutes")
  // A paid journey can be edited until this long before its pick-up.
  editCutoffMinutes    Int      @default(240) @map("edit_cutoff_minutes")
  // An unpaid booking is let go after this long.
  unpaidExpiryMinutes  Int      @default(30) @map("unpaid_expiry_minutes")
  // The driver's name, car and phone are shown this long before pick-up.
  driverDetailsMinutes Int      @default(60) @map("driver_details_minutes")
  // How long a saved quote can be booked at its price.
  quoteValidMinutes    Int      @default(30) @map("quote_valid_minutes")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

// A priced journey, kept for a short while so that booking it (Module 6)
// charges exactly what the customer was shown. The browser sends back the
// quote's id, a class and its choices; the total it shows is compared with
// the saved price, never charged.
model Quote {
  id             String   @id @default(uuid())
  // The journey as the server understood it: each leg's places with their
  // postcodes and airports, pick-up time, distance and duration; the party.
  journey        Json
  // Every class on offer at that moment, with its price per leg and its lines.
  options        Json
  // The Meet & Greet price at that moment, added per leg when chosen.
  meetGreetPence Int      @map("meet_greet_pence")
  // After this, booking needs a new quote.
  expiresAt      DateTime @map("expires_at")
  createdAt      DateTime @default(now()) @map("created_at")

  // The clean-up job deletes by expiry.
  @@index([expiresAt])
  @@map("quotes")
}

// Where a journey stands. Its whole life is named now, so journeys (Module
// 9), the admin panel (11) and the driver API (14) share one vocabulary.
// Module 6 sets PENDING and EXPIRED; the rest come with their modules, like
// the DRIVER role was named before there were drivers.
enum BookingStatus {
  // Booked from a quote and waiting for payment. Let go at expiresAt if
  // still unpaid.
  PENDING
  // Paid: the journey goes ahead (wallet in Module 7, card in Module 8).
  CONFIRMED
  // A driver has taken the job (Module 11; the driver API in 14).
  ACCEPTED
  // The driver is on the way to the pick-up.
  ON_ROUTE
  // The driver is at the pick-up.
  ARRIVED
  // The passenger is in the car.
  ON_BOARD
  // Finished. Can be reviewed (Module 12).
  COMPLETED
  // The passenger did not come.
  NO_SHOW
  // Called off by the customer (Module 10) or the office (11). Kept for the
  // record.
  CANCELLED
  // Not paid in time. Final: booking again needs a new quote.
  EXPIRED
}

// The money side of a booking, kept apart from its life: a cancelled journey
// may have been paid, an expired one never was. Named for the booking so that
// "PaymentStatus" stays free for the card payments of Module 8. Module 10
// adds the refund values.
enum BookingPaymentStatus {
  // Nothing received yet.
  UNPAID
  // This journey's price is fully paid, from the wallet, by card or both.
  PAID
}

// Which way a journey runs. The same words as a quote's legs.
enum LegDirection {
  OUTBOUND
  // From the drop-off back to the pick-up, through the stops in reverse.
  RETURN
}

// What happened to a booking. Each later step adds the kinds it writes
// (PAID in Modules 7 and 8, CANCELLED in 10, DRIVER_ASSIGNED in 11, ...).
enum BookingEventType {
  // Booked from a quote.
  CREATED
  // Not paid in time.
  EXPIRED
}

// Who caused an event.
enum BookingActor {
  // The customer, signed in or as a guest.
  CUSTOMER
  // Someone using the admin panel (Module 11).
  STAFF
  // The driver (Module 14).
  DRIVER
  // The API itself: the expiry job, a payment webhook.
  SYSTEM
}

// One press of Book: the journeys booked together from one quote, the
// outbound and, for a return, the journey back. They are paid together
// (Modules 7 and 8); each journey has its own reference, status and price.
// The combined total is the sum of its bookings and is never stored, so it
// cannot disagree with them.
model Trip {
  id               String   @id @default(uuid())
  // The quote it was booked from. Unique: a quote is booked once, so a double
  // click or a second tab cannot book it twice. A plain column, not a
  // relation: the clean-up deletes expired quotes, and trips stay.
  quoteId          String   @unique @map("quote_id")
  // Who the journeys were booked for, as given when booking: the lead
  // passenger's name, for the driver's name board, and how to reach them.
  // Copied from the profile, or typed by a guest, so a later change to the
  // account never rewrites a booking.
  contactFirstName String   @map("contact_first_name")
  contactLastName  String   @map("contact_last_name")
  contactEmail     String   @map("contact_email")
  contactMobile    String   @map("contact_mobile")
  createdAt        DateTime @default(now()) @map("created_at")

  bookings Booking[]

  @@map("trips")
}

// One journey: one pick-up time, one route, one class of car. What it shows
// and what it costs are copied from the quote, so later changes to prices,
// classes, airports or settings never change a booking.
model Booking {
  id            String               @id @default(uuid())
  // What the customer, the office and the driver call it: "UKR-7F3K9Q".
  reference     String               @unique
  tripId        String               @map("trip_id")
  // Restrict: trips and bookings are history and are never deleted.
  trip          Trip                 @relation(fields: [tripId], references: [id], onDelete: Restrict)
  direction     LegDirection
  // The account that booked it: signed in, or a guest's passwordless account.
  userId        String               @map("user_id")
  // Restrict: an account with journeys is never deleted.
  user          User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  status        BookingStatus        @default(PENDING)
  paymentStatus BookingPaymentStatus @default(UNPAID) @map("payment_status")
  // An unpaid booking is let go at this moment: unpaidExpiryMinutes after
  // booking, or sooner when the pick-up comes within the booking lead time.
  // Fixed when it is made; both journeys of a trip share it.
  expiresAt     DateTime             @map("expires_at")

  // The journey as quoted.
  pickupAt        DateTime @map("pickup_at")
  // Each place in driving order: label, latitude, longitude, postcode,
  // district and airport ({ code, name } or null). The first place's airport
  // is the airport pick-up.
  places          Json
  distanceMiles   Float    @map("distance_miles")
  durationMinutes Int      @map("duration_minutes")
  // Set exactly when the journey starts at an airport, where it is required.
  // In capitals without spaces: "BA117".
  flightNumber    String?  @map("flight_number")
  // Meet & Greet was chosen. Kept apart from its price, which an admin may
  // set to 0.
  meetGreet       Boolean  @default(false) @map("meet_greet")
  // For the driver, such as "a child seat, please". Optional.
  notes           String?

  // The class booked (switched off, never deleted, so the link keeps working)
  // and what the customer saw of it: slug, name, example models and capacity.
  vehicleTypeId       String      @map("vehicle_type_id")
  vehicleType         VehicleType @relation(fields: [vehicleTypeId], references: [id], onDelete: Restrict)
  vehicleTypeSnapshot Json        @map("vehicle_type_snapshot")
  // The party, from the quote. Never from the request.
  passengers          Int
  suitcases           Int
  handLuggage         Int         @map("hand_luggage")

  // The price as agreed, in whole pence: the quote's figures for this journey,
  // plus Meet & Greet at the quote's price when chosen. The lines add up to
  // totalPence.
  lines           Json
  discountPercent Int  @map("discount_percent")
  originalPence   Int  @map("original_pence")
  discountPence   Int  @map("discount_pence")
  // originalPence less discountPence.
  farePence       Int  @map("fare_pence")
  // The quote's Meet & Greet price when chosen, otherwise 0.
  meetGreetPence  Int  @map("meet_greet_pence")
  // farePence plus meetGreetPence: what this journey costs.
  totalPence      Int  @map("total_pence")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  events BookingEvent[]

  // One outbound and at most one return per trip. Its first column also
  // serves as the index on trip_id.
  @@unique([tripId, direction])
  // A customer's journeys by pick-up time (Module 9). Its first column also
  // serves as the index on user_id.
  @@index([userId, pickupAt])
  @@index([vehicleTypeId])
  // The expiry job: PENDING bookings whose time has come.
  @@index([status, expiresAt])
  @@map("bookings")
}

// A booking's history: one row per thing that happened, written in the same
// transaction as the change it records. Never changed or deleted.
model BookingEvent {
  id            String               @id @default(uuid())
  bookingId     String               @map("booking_id")
  // Cascade: an event means nothing without its booking (and bookings are
  // never deleted anyway).
  booking       Booking              @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  type          BookingEventType
  // The booking's statuses just after this event, so a timeline needs no
  // replay.
  status        BookingStatus
  paymentStatus BookingPaymentStatus @map("payment_status")
  actor         BookingActor
  // The person, for CUSTOMER, STAFF and DRIVER; null for SYSTEM. SetNull:
  // the history outlives an account.
  actorUserId   String?              @map("actor_user_id")
  actorUser     User?                @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  // Plain facts about the event, never personal data. CREATED records how it
  // was booked: { via: "SIGNED_IN" } or { via: "GUEST", account: "CREATED" }.
  data          Json?
  createdAt     DateTime             @default(now()) @map("created_at")

  @@index([bookingId, createdAt])
  @@index([actorUserId])
  @@map("booking_events")
}

// What a one-time code is for. A code (and the ticket it turns into) only
// works for the purpose it was sent for.
enum OtpPurpose {
  SIGNUP
  GUEST_BOOKING
  CHANGE_MOBILE
  RESET_PASSWORD
}

enum OtpChannel {
  SMS
  EMAIL
}

// A six-digit code sent to a phone or an email. Only a keyed hash is stored.
model OtpCode {
  id           String     @id @default(uuid())
  purpose      OtpPurpose
  channel      OtpChannel
  // The phone (+447400123456) or email the code was sent to.
  target       String
  codeHash     String     @map("code_hash")
  // Wrong guesses so far. Five end the code.
  attempts     Int        @default(0)
  expiresAt    DateTime   @map("expires_at")
  // Set when the code is used, or replaced by a newer one.
  consumedAt   DateTime?  @map("consumed_at")
  // Set when the ticket it was exchanged for is spent. A ticket works once.
  ticketUsedAt DateTime?  @map("ticket_used_at")
  createdAt    DateTime   @default(now()) @map("created_at")

  @@index([target, purpose, createdAt])
  @@map("otp_codes")
}
