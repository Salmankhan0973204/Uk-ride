meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "firstName": "Sara",
    "lastName": "Khan",
    "email": "sara@example.com",
    "mobile": "+44 7400 123456",
    "gender": "FEMALE",
    "password": "secret-pass-1"
  }
}

assert {
  res.status: eq 201
  res.body.data.user.email: eq sara@example.com
  res.body.data.user.mobile: eq +447400123456
  res.body.data.user.passwordHash: isUndefined
}

docs {
  Run it twice: the second call answers 409 CONFLICT, because the email is taken.
  gender is optional: remove the line to leave it out.
  Change the email, or delete the row in Prisma Studio, to get 201 again.
}
