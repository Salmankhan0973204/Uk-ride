meta {
  name: Get Quotes
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/quotes
  body: json
  auth: none
}

body:json {
  {
    "pickupPostcode": "SW1A 1AA",
    "dropoffPostcode": "TW6 1EW",
    "pickupAt": "2026-11-02T23:30:00Z",
    "airport": true
  }
}

assert {
  res.status: eq 200
  res.body.data.quotes: isArray
}

docs {
  Public. The road distance between the postcodes is measured; or send "distanceMiles"
  instead of the two postcodes. Add "vehicleType": "executive" to price one type only. quotes is empty until an
  admin has set prices (Admin Set Pricing).
}
