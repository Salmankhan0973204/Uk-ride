meta {
  name: Change Password
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/users/me/password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "currentPassword": "secret-pass-1",
    "newPassword": "a-brand-new-pass"
  }
}

assert {
  res.status: eq 200
}

docs {
  Run it twice: the second call answers 400, because the current password has changed.
  The access token you used keeps working; other devices are signed out.
}
