meta {
  name: Admin Update Vehicle
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/admin/vehicles/{{vehicleId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "colour": "Silver"
  }
}

assert {
  res.status: eq 200
}

docs {
  Send only what changes. Status is not accepted here.
}
